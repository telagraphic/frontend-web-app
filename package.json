{
  "name": "frontend-web-app",
  "version": "0.1.0",
  "description": "Starter for a content-driven site on Bun. The setup wizard writes a new site.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telagraphic/frontend-web-app.git"
  },
  "bin": "wizard/create.js",
  "files": [
    "app",
    "server",
    "styles",
    "views",
    "public",
    "wizard",
    "tests",
    "documentation",
    ".cursor",
    "scripts",
    "eslint.config.mjs",
    "playwright.config.js",
    "tsconfig.json",
    ".prettierrc",
    ".stylelintrc.json",
    ".htmlvalidate.json",
    ".gitignore",
    "bun.lock",
    "AGENTS.md",
    "GLOSSARY.md"
  ],
  "scripts": {
    "create": "bun wizard/create.js",
    "setups": "bun scripts/create-setups.js",
    "docs:dev": "bun server/docs.js",
    "dev": "bun server/dev.js",
    "dev:docs": "bun run dev & bun run docs:dev & wait",
    "build": "bun server/build.js",
    "preview": "bun server/preview.js",
    "test": "bun test tests/unit tests/wiring",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "lint": "bun run lint:js && bun run lint:css && bun run lint:html",
    "lint:js": "eslint \"app/**/*.js\" \"server/**/*.js\"",
    "lint:js:fix": "eslint \"app/**/*.js\" \"server/**/*.js\" --fix",
    "lint:css": "stylelint \"styles/**/*.css\"",
    "lint:css:fix": "stylelint \"styles/**/*.css\" --fix",
    "lint:html": "bun server/lint-html.js",
    "format": "prettier --write \"app/**/*.js\" \"server/**/*.js\" \"views/**/*.njk\" \"styles/**/*.css\"",
    "format:check": "prettier --check \"app/**/*.js\" \"server/**/*.js\" \"views/**/*.njk\" \"styles/**/*.css\"",
    "clean": "rm -rf dist .dev",
    "process:image": "bun scripts/process-image.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "avif": "^0.5.3",
    "gsap": "^3.15.1",
    "hono": "^4.13.16",
    "lenis": "^1.3.27",
    "marked": "^18.2.0",
    "nunjucks": "^3.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.65.0",
    "@types/bun": "latest",
    "eslint": "^9.34.0",
    "glob": "^11.0.3",
    "globals": "^16.3.0",
    "happy-dom": "^21.0.4",
    "html-validate": "^11.18.0",
    "prettier": "^3.6.2",
    "prettier-plugin-nunjucks": "^0.2.3",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0"
  },
  "browserslist": [
    "defaults",
    "not ie <= 11",
    "maintained node versions"
  ],
  "peerDependencies": {
    "typescript": "^5"
  }
}
